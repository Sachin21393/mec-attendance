# Copy to .env for local development. Never commit real secrets.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:55432/attendance
DB_USERNAME=attendance
DB_PASSWORD=attendance_dev_pass

# 32-byte (256-bit) Base64 key for AES-256-GCM biometric template encryption
BIOMETRICS_ENCRYPTION_KEY_B64=MDEyMzQ1Njc4OUFCQ0RFRjAxMjM0NTY3ODlBQkNERUY=
BIOMETRICS_KEY_VERSION=v1

APP_COOKIE_SECURE=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeLocalDev123!

ATTENDANCE_BIOMETRICS_PROVIDER=onnx
ATTENDANCE_PRODUCTION_BIOMETRICS_ENABLED=true
